diff --git a/kernel/feature/susfs_control.c b/kernel/feature/susfs_control.c
new file mode 100644
index 00000000..54dda600
--- /dev/null
+++ b/kernel/feature/susfs_control.c
@@ -0,0 +1,120 @@
+/*
+ * Connect SUSFS v2.3.0 to the maintained legacy driver, retaining its root hooks
+ * and UAPI 5 so the released manager does not need a fork or downgrade.
+ * Command IDs and handlers follow the upstream SUSFS header and pershoot's dispatcher.
+ */
+#include <linux/cred.h>
+#include <linux/security.h>
+#include <linux/string.h>
+#include <linux/slab.h>
+#include <linux/task_work.h>
+#include "compat/kernel_compat.h"
+#include <linux/susfs.h>
+#include "feature/susfs_control.h"
+#include "selinux/selinux.h"
+
+/* VFS hooks compare cached SIDs rather than resolving SELinux contexts in hot paths. */
+u32 susfs_ksu_sid;
+u32 susfs_priv_app_sid;
+
+void ksu_susfs_cache_sids(void)
+{
+    security_secctx_to_secid(KERNEL_SU_CONTEXT, strlen(KERNEL_SU_CONTEXT), &susfs_ksu_sid);
+    security_secctx_to_secid("u:r:priv_app:s0", strlen("u:r:priv_app:s0"), &susfs_priv_app_sid);
+}
+
+bool susfs_is_current_ksu_domain(void)
+{
+    /* A zero SID means policy has not supplied the domain yet. */
+    return susfs_ksu_sid && current_sid() == susfs_ksu_sid;
+}
+
+/* Keep the cold RPC switch separate from the task-work trampoline for binary auditing. */
+noinline int ksu_susfs_control(unsigned int cmd, void __user **arg)
+{
+    /* The reboot hook enforces root before reaching this fixed set of SUSFS operations. */
+    switch (cmd) {
+    case CMD_SUSFS_ADD_SUS_PATH:
+        susfs_add_sus_path(arg);
+        return 0;
+    case CMD_SUSFS_ADD_SUS_PATH_LOOP:
+        susfs_add_sus_path_loop(arg);
+        return 0;
+    case CMD_SUSFS_HIDE_SUS_MNTS_FOR_NON_SU_PROCS:
+        susfs_set_hide_sus_mnts_for_non_su_procs(arg);
+        return 0;
+    case CMD_SUSFS_ADD_SUS_KSTAT:
+        susfs_add_sus_kstat(arg);
+        return 0;
+    case CMD_SUSFS_UPDATE_SUS_KSTAT:
+        susfs_update_sus_kstat(arg);
+        return 0;
+    case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY:
+        susfs_add_sus_kstat(arg);
+        return 0;
+    case CMD_SUSFS_SET_UNAME:
+        susfs_set_uname(arg);
+        return 0;
+    case CMD_SUSFS_ENABLE_LOG:
+        susfs_enable_log(arg);
+        return 0;
+    case CMD_SUSFS_SET_CMDLINE_OR_BOOTCONFIG:
+        susfs_set_cmdline_or_bootconfig(arg);
+        return 0;
+    case CMD_SUSFS_ADD_OPEN_REDIRECT:
+        susfs_add_open_redirect(arg);
+        return 0;
+    case CMD_SUSFS_ADD_SUS_MAP:
+        susfs_add_sus_map(arg);
+        return 0;
+    case CMD_SUSFS_ENABLE_AVC_LOG_SPOOFING:
+        susfs_set_avc_log_spoofing(arg);
+        return 0;
+    case CMD_SUSFS_SHOW_ENABLED_FEATURES:
+        susfs_get_enabled_features(arg);
+        return 0;
+    case CMD_SUSFS_SHOW_VARIANT:
+        susfs_show_variant(arg);
+        return 0;
+    case CMD_SUSFS_SHOW_VERSION:
+        susfs_show_version(arg);
+        return 0;
+    default:
+        /* Deprecated operations are rejected rather than emulated with an obsolete ABI. */
+        return -EINVAL;
+    }
+}
+
+/* Preserve the caller's address until task work runs before its return to userspace. */
+struct susfs_control_work {
+    struct callback_head callback;
+    unsigned int cmd;
+    void __user *arg;
+};
+
+static void susfs_control_task_work(struct callback_head *callback)
+{
+    struct susfs_control_work *work = container_of(callback, struct susfs_control_work, callback);
+
+    /* This runs in the original task context, where user copies and sleeping allocations are valid. */
+    ksu_susfs_control(work->cmd, &work->arg);
+    kfree(work);
+}
+
+int ksu_susfs_schedule(unsigned int cmd, void __user *arg)
+{
+    struct susfs_control_work *work;
+    int error;
+
+    /* The probe may not sleep; defer the command using the driver's existing fd-install pattern. */
+    work = kzalloc(sizeof(*work), GFP_ATOMIC);
+    if (!work)
+        return -ENOMEM;
+    work->cmd = cmd;
+    work->arg = arg;
+    work->callback.func = susfs_control_task_work;
+    error = task_work_add(current, &work->callback, TWA_RESUME);
+    if (error)
+        kfree(work);
+    return error;
+}
diff --git a/kernel/feature/susfs_control.h b/kernel/feature/susfs_control.h
new file mode 100644
index 00000000..cc62510b
--- /dev/null
+++ b/kernel/feature/susfs_control.h
@@ -0,0 +1,11 @@
+/* Glue for the pinned 5.4 VFS patch; the KernelSU userspace ABI remains unchanged. */
+#ifndef KSU_SUSFS_CONTROL_H
+#define KSU_SUSFS_CONTROL_H
+#include <linux/types.h>
+#include <linux/workqueue.h>
+extern struct work_struct susfs_extra_works;
+bool susfs_is_current_ksu_domain(void);
+void ksu_susfs_cache_sids(void);
+int ksu_susfs_control(unsigned int cmd, void __user **arg);
+int ksu_susfs_schedule(unsigned int cmd, void __user *arg);
+#endif
diff --git a/kernel/hook/setuid_hook.c b/kernel/hook/setuid_hook.c
index 3dddf937..9a7ff431 100644
--- a/kernel/hook/setuid_hook.c
+++ b/kernel/hook/setuid_hook.c
@@ -26,8 +26,26 @@
 #include "feature/kernel_umount.h"
 #include "compat/kernel_compat.h"
 
+#ifdef CONFIG_KSU_SUSFS
+#include <linux/susfs.h>
+#include "feature/susfs_control.h"
+#endif
+
 int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 {
+#ifdef CONFIG_KSU_SUSFS
+    /* Recompute inherited VFS flags as zygote specializes each app, before any early return. */
+    if (is_uid_manager(new_uid) || ksu_is_allow_uid_for_current(new_uid)) {
+        susfs_clear_current_proc_no_su();
+        susfs_clear_current_proc_umounted();
+    } else if (new_uid >= 10000) {
+        susfs_set_current_proc_no_su();
+        if (ksu_uid_should_umount(new_uid))
+            susfs_set_current_proc_umounted();
+        else
+            susfs_clear_current_proc_umounted();
+    }
+#endif
     // we rely on the fact that zygote always call setresuid(3) with same uids
 
     pr_info("handle_setresuid from %d to %d\n", old_uid, new_uid);
@@ -71,6 +89,10 @@ int ksu_handle_setresuid(uid_t old_uid, uid_t new_uid)
 
     // Handle kernel umount
     ksu_handle_umount(old_uid, new_uid);
+#ifdef CONFIG_KSU_SUSFS
+    /* Defer path refreshes outside the syscall's immediate path. */
+    schedule_work(&susfs_extra_works);
+#endif
 
     return 0;
 }
